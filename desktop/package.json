{
  "name": "vela",
  "productName": "Vela",
  "version": "1.7.0",
  "description": "Vela desktop",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "cross-fetch": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "hls.js": "1.7.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "zustand": "5.0.15"
  },
  "build": {
    "appId": "com.vela.app",
    "productName": "Vela",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["out/**/*", "package.json"],
    "extraResources": [{ "from": "resources/icon.png", "to": "icon.png" }],
    "protocols": [{ "name": "Vela", "schemes": ["vela", "vixscr"] }],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Vela-Setup-${version}.exe",
      "shortcutName": "Vela",
      "uninstallDisplayName": "Vela",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
