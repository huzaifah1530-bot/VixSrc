{
  "name": "vela",
  "productName": "Vela",
  "version": "1.9.1",
  "description": "Vela desktop",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:party": "npx --yes esbuild@0.25.0 scripts/party-sim.ts --bundle --platform=node --outfile=scripts/party-sim.cjs --log-level=warning && node scripts/party-sim.cjs",
    "test:sync": "npx --yes esbuild@0.25.0 scripts/sync-test.ts --bundle --platform=node --outfile=scripts/sync-test.cjs --log-level=warning && node scripts/sync-test.cjs",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "bonjour-service": "1.4.4",
    "cross-fetch": "4.1.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@noble/ciphers": "2.4.0",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "hls.js": "1.7.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "zustand": "5.0.15"
  },
  "build": {
    "appId": "com.vela.app",
    "productName": "Vela",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "protocols": [
      {
        "name": "Vela",
        "schemes": [
          "vela",
          "vixscr"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Vela-Setup-${version}.exe",
      "shortcutName": "Vela",
      "uninstallDisplayName": "Vela",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
